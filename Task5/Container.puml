@startuml Standart_Container
title Standart Container Diagram

!include ../c4/C4_Container.puml

' ПОЛЬЗОВАТЕЛИ
Person_Ext(Customer, "Customer", "Клиент:\n— Просматривает предложение по кредитам\n— Оформляет заявку на кредит")
Person(BackOfficeCreditUser, "Back-Office (Credit)", "Сотрудник бэк-фиса (кредит):\n— Анализирует кредитные риски по клиенту")
Person(FrontOfficeUser, "Front-Office", "Сотрудник фронт-фиса\n— Идентифицирует клиента\n- Оформляет документы по заявкам на кредит")

' ВНЕШНИЕ СИСТЕМЫ
System_Ext(CreditHistorySystem, "Credit History", "Бюро кредитных историй")
System_Ext(TelecomSystem, "Telecom System", "Телеком-оператор")

' ВНУТРЕННИЕ СИСТЕМЫ
System(ABSSystem, "ABS", "Система АБС")
System(InternetBankSystem, "Internet Bank", "Интернет-банк")
System_Boundary(CreditProcessingSystem, "Credit Processing", "Кредитный процессинг"){
    Container(CreditProcessing, "Credit Processing", "MS SQL", "Сервис управления заявками на кредит и кредитными предложениями")
    ContainerDb(CreditDatabase, "Credit Processing Database", "Oracle", "Хранение данных заявок на кредит и кредитных предложений")
    ContainerQueue(CreditQueue, "Credit Processing Queue", "Kafka", "Передача событий по заявкам на кредит")
    
    Rel(CreditProcessing, CreditDatabase, "Чтение/запись данных заявок", "SQL") 
    Rel(CreditQueue, CreditProcessing, "Получение событий по заявкам", "") 
}
System(CreditPipelineSystem, "Credit Pipeline", "Кредитный конвейер")
System(CreditScoringSystem, "Credit Scoring", "Кредитный скоринг")
System(SiteSystem, "Site", "Сайт банка")
System(SMSGateway, "SMS Gateway", "СМС-шлюз телеком-оператора")

' ВЗАИМОДЕЙСТВИЯ
Rel(Customer, SiteSystem, "Просмотр кредитных предложений\n и оформление заявок")
Rel(Customer, InternetBankSystem, "Просмотр кредитных предложений\n и оформление заявок")
Rel(BackOfficeCreditUser, CreditPipelineSystem, "Обработка заявок на кредит")
Rel_U(FrontOfficeUser, ABSSystem, "Идентификация клиента\nОформление заявок на кредит")

Rel(CreditProcessing, SMSGateway, "Отправка уведомлений по заявке")
Rel(InternetBankSystem, SMSGateway, "Отправка СМС для подтверждения операций")
Rel_R(SMSGateway, TelecomSystem, "Отправка СМС")

Rel(SiteSystem, CreditQueue, "Создание заявки на кредит")
Rel(InternetBankSystem, CreditQueue, "Создание заявки на кредит")
Rel(InternetBankSystem, CreditProcessing, "Получение предодобренных предложения")

Rel_R(CreditProcessing, ABSSystem, "Получение данных о клиенте,\nЗапись одобренной заявки на кредит")
Rel(CreditProcessing, CreditPipelineSystem, "Отправка заявки в обработку,\nполучение статуса заявки")
Rel(ABSSystem, CreditQueue, "Регистрация новой заявки на кредит")

Rel(CreditPipelineSystem, CreditScoringSystem, "Скоринг клиента по заявке на кредит")

Rel_U(CreditScoringSystem, CreditHistorySystem, "Получение кредитной истории клиента")
Rel(CreditScoringSystem, ABSSystem, "Получение данных клиента")

@enduml